#version 430 core
// #extension GL_ARB_gpu_shader_fp64 : require
flat in dvec3 our_color;
out vec4 color;
flat in dvec2 our_texture;

uniform sampler2D texture_sample1;
uniform sampler2D texture_sample2;


void main()
{
    // color = texture(texture_sample1, our_texture);

    color = vec4(mix(texture(texture_sample1, vec2(our_texture)), texture(texture_sample2, vec2(our_texture)), 0.2)  * vec4(our_color, 1.0f));
}
