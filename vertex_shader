#version 430 core
// #extension GL_ARB_gpu_shader_fp64 : require
layout (location = 0) in dvec3 position;
layout (location = 1) in dvec3 in_color;
layout (location = 2) in dvec2 texture_v;
out vec3 our_color;
out vec2 our_texture;

uniform dmat4 transformation;


void main()
{
	gl_Position=vec4(transformation*dvec4(position, 1.0));
	our_color = vec3(in_color);
	our_texture = vec2(texture_v);
	// our_texture = dvec2(texture_v.x, 1-texture_v.y);
}
